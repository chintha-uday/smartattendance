APP_NAME=Smart Attendance
APP_SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
TIME_ZONE=India Standard Time

# SQL Server deployment (recommended)
DB_URL=mssql+pyodbc://@localhost/SmartAttendanceDB?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# For first-time local demo only, you may instead use:
# DB_URL=sqlite:///./smartattendance_dev.db
